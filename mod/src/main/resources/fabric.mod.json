{
  "schemaVersion": 1,
  "id": "${id}",
  "version": "${version}",
  "name": "${name}",
  "description": "Auction house, orders and market tools for HugoSMP.",
  "authors": [
    "vntx-x"
  ],
  "contact": {
    "homepage": "https://github.com/vntx-x/hugonomics",
    "sources": "https://github.com/vntx-x/hugonomics",
    "issues": "https://github.com/vntx-x/hugonomics/issues"
  },
  "license": "MIT",
  "icon": "assets/hugomarket/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.hugomarket.HugoMarketClient"
    ],
    "modmenu": [
      "dev.hugomarket.config.ModMenuEntry"
    ]
  },
  "mixins": [
    "hugomarket.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader}",
    "fabric-api": "*",
    "minecraft": "${minecraft}",
    "java": ">=21"
  }
}
